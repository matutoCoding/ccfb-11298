{
  "name": "rug-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:physics": "esbuild scripts/test-physics.ts --bundle --platform=node --format=esm --outfile=scripts/.test-build.mjs --log-level=warning && node scripts/.test-build.mjs",
    "test:conversion": "esbuild scripts/test-conversion.ts --bundle --platform=node --format=esm --outfile=scripts/.conv-build.mjs --log-level=warning && node scripts/.conv-build.mjs",
    "test:shaders": "esbuild scripts/test-shaders.ts --bundle --platform=node --format=esm --outfile=scripts/.shader-build.mjs --log-level=warning && node scripts/.shader-build.mjs",
    "test": "npm run test:physics && npm run test:conversion && npm run test:shaders"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
